{
  "manifest_version": 3,
  "name": "Webvideo FullScreen Plus",
  "version": "1.0.0",
  "icons": {
    "128": "./assets/fullscreen_icon_128_purple.png"
  },
  "action": {
    "default_title": "Full-window-plus"
  },
  "background": {
    "service_worker": "background.ts",
    "type": "module"
  },
  "permissions": ["scripting"],
  "web_accessible_resources": [
    {
      "resources": ["lib/injected.ts"],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/content.ts"],
      "all_frames": true
    }
  ]
}
